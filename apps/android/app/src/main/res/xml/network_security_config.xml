<?xml version="1.0" encoding="utf-8"?>
<!--
  Release posture: HTTPS only, except loopback — the dev API lives on
  127.0.0.1 behind `adb reverse`. Anything else must be TLS (named
  Cloudflare Tunnel), so a misconfigured endpoint fails closed instead
  of leaking session tokens in cleartext.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
