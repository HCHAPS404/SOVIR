<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Observador UI_TREE (ADR-0014): INTERNET para la API de SOVIR;
      AccessibilityService declarado — el usuario lo activa en ajustes del
      sistema (el SO concede la captura) y además concede en la app el
      permiso de envío (el grant de SOVIR). Sin MediaProjection,
      micrófono, cámara, ubicación ni SMS.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Avisos de alertas: runtime en Android 13+; denegado = sin avisos, nada se rompe. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Solo para que el sondeo periódico de alertas (JobScheduler.setPersisted)
         sobreviva a un reinicio. No arranca ningún servicio propio al encender. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Visibilidad de paquetes (Android 11+): solo los paquetes sensibles
         que conocemos — sin esto getInstalledPackages devuelve lista vacía
         y la UI de exenciones no detecta nada. Nombrados, no QUERY_ALL_PACKAGES. -->
    <queries>
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
        <package android:name="com.instagram.android" />
        <package android:name="com.facebook.katana" />
        <package android:name="com.facebook.orca" />
        <package android:name="org.telegram.messenger" />
        <package android:name="com.zhiliaoapp.musically" />
        <package android:name="com.twitter.android" />
        <package android:name="com.snapchat.android" />
        <package android:name="org.thoughtcrime.securesms" />
        <package android:name="com.bbva.bbvacontigo" />
        <package android:name="es.bancosantander.apps" />
        <package android:name="es.caixabank.MobilePhone" />
        <package android:name="com.bancsabadell.BSApp" />
        <package android:name="com.ingdirect.b2c" />
        <package android:name="com.revolut.revolut" />
        <package android:name="de.number26.android" />
        <package android:name="com.transferwise.android" />
        <package android:name="com.paypal.android.p2pmobile" />
        <package android:name="com.mercadopago.wallet" />
        <package android:name="com.binance.dev" />
        <package android:name="com.coinbase.android" />
        <package android:name="com.kraken.invest" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Sovir"
        android:networkSecurityConfig="@xml/network_security_config">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Vuelta del registro/inicio en el navegador (OIDC + PKCE). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="app.sovir.android" android:host="oauth" />
            </intent-filter>
        </activity>
        <service
            android:name=".observer.SovirAccessibilityService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/sovir_accessibility_service" />
        </service>
        <service
            android:name=".observer.AlertSync"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
    </application>
</manifest>
