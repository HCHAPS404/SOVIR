{
  "manifest_version": 3,
  "name": "SOVIR",
  "version": "0.2.0",
  "description": "Observador local por sitio. Extrae señales tipadas (nunca contenido) solo donde el usuario lo activa.",
  "icons": {
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SOVIR",
    "default_icon": "icons/icon-128.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": ["storage", "scripting"],
  "host_permissions": ["http://127.0.0.1:8787/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  }
}
