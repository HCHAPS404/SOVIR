{
  "manifest_version": 3,
  "name": "SOVIR",
  "version": "0.2.0",
  "description": "Observador local continuo. Extrae señales tipadas (nunca contenido) en las páginas que visitas — consentimiento único al instalar, excepciones editables.",
  "icons": {
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SOVIR",
    "default_icon": "icons/sovir-symbol-white.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": ["storage", "scripting", "activeTab", "identity"],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:8787/*",
    "https://hell.taile32c7d.ts.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
