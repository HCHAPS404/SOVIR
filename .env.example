# Never commit a real API key or user data.
SOVIR_ENV=local
SOVIR_MODEL_PROVIDER=mock
SOVIR_MODEL_NAME=muse-spark-1.3
SOVIR_ALLOW_REMOTE_INFERENCE=false
SOVIR_MAX_USD_PER_DAY=0
SOVIR_MAX_USD_PER_USER_MONTH=0
SOVIR_TELEMETRY_ENABLED=false
# Set real secrets in your secret manager, not this file:
# META_MODEL_API_KEY=
# BASETEN_API_KEY=
# MODAL_TOKEN_ID= / MODAL_TOKEN_SECRET=
# FIREWORKS_API_KEY=

# Backend development-only (NEVER use demo token for production)
SOVIR_API_BIND=127.0.0.1:8787
# SOVIR_API_DEV_TOKEN=<generate with python secrets.token_urlsafe(32)>
# Optional PostgreSQL sandbox only; adapter is not implemented
# SOVIR_POSTGRES_DEV_PASSWORD=<local dev only>
