# SOVIR environment template — copy to .env.local (never commit it).
# Never put a real API key or user data in this file.

# --- Core (all environments) ---
SOVIR_ENV=local            # local | test | ci
SOVIR_MODEL_PROVIDER=mock
SOVIR_MODEL_NAME=muse-spark-1.3
SOVIR_ALLOW_REMOTE_INFERENCE=false   # server FAILS startup when true
SOVIR_MAX_USD_PER_DAY=0
SOVIR_MAX_USD_PER_USER_MONTH=0
SOVIR_TELEMETRY_ENABLED=false

# --- Development API (loopback only; NEVER production) ---
SOVIR_API_BIND=127.0.0.1:8787
# Auth = dev sessions issued by POST /v1/auth/dev-session (enabled only when
# SOVIR_ENV is local|test). No global bearer token is needed anymore.
SOVIR_RATE_LIMIT_PER_MIN=60        # fixed window, keyed by principal+device
# Retention cutoff for POST /v1/me/retention (default 30 days, ms).
# SOVIR_RETENTION_MS=2592000000
# Scheduled global sweep interval; 0/unset disables (per-principal
# /v1/me/retention endpoint works regardless).
# SOVIR_RETENTION_SWEEP_MS=3600000
# Scheduled global dispatch sweep for due interventions; 0/unset disables.
# SOVIR_DISPATCH_SWEEP_MS=60000
# Per-tenant hard cap for inference spend, whole USD (ADR-0012).
# Default 0 = no inference spend allowed; only used with DATABASE_URL.
# SOVIR_INFERENCE_BUDGET_USD=0
# Server-side price per inference request, micro-USD (def 10000 = $0.01).
# Clients can never set their own cost.
# SOVIR_INFERENCE_REQ_COST_MICROS=10000
# Remote inference provider (B4): all three required AND real egress on.
# Without them /v1/inference/assess answers 503 provider_unavailable.
# SOVIR_INFERENCE_URL=https://provider.example.com/v1/assess
# SOVIR_INFERENCE_KEY=<secret — never commit>
# SOVIR_INFERENCE_MODEL=muse-spark-1.3
# Threat-intel candidate source (B5): local JSON fixture of IntelIndicator
# items with provenance; unset = empty feed.
# SOVIR_INTEL_FIXTURE=fixtures/intel-dev.json
# Optional integrity pin: sha256 (hex) the fixture file must match or pulls
# fail closed. Integrity check vs a configured digest — not authenticity/PKI.
# SOVIR_INTEL_FIXTURE_SHA256=<64 hex chars>
# Versioned policy pack (B3): JSON file matching packages/contracts/policy/
# dev-risk-pack.v1.json. Unset = built-in dev pack; invalid file = refuse start.
# SOVIR_POLICY_PACK=packages/contracts/policy/dev-risk-pack.v1.json
# OIDC seam (B6/ADR-0013): verify JWT bearers against public JWKS fetched
# through controlled egress (the JWKS host must be allowlisted below and
# SOVIR_HTTP_EGRESS=real). ALL THREE required or startup refuses; unset =
# dev sessions only. tenant/principal come only from validated claims.
# SOVIR_OIDC_JWKS_URL=https://issuer.example/.well-known/jwks.json
# SOVIR_OIDC_ISSUER=https://issuer.example
# SOVIR_OIDC_AUDIENCE=sovir-api
# SOVIR_OIDC_TENANT_CLAIM=tenant_id
# SOVIR_OIDC_PRINCIPAL_CLAIM=sub
# B20 egress allowlist: comma-separated hosts; webhook registration rejects
# any URL whose host is not listed (SSRF guard). Default: 127.0.0.1,localhost
# SOVIR_WEBHOOK_ALLOWLIST=127.0.0.1,localhost
# Real HTTP egress (ADR-0010): only honored with an explicit non-empty
# allowlist AND SOVIR_ENV=local|test. Anything else records — no network.
# SOVIR_HTTP_EGRESS=record

# --- PostgreSQL sandbox (optional; adapter and Docker deferred) ---
# DATABASE_URL=postgres://sovir_dev:${SOVIR_POSTGRES_DEV_PASSWORD}@127.0.0.1:5433/sovir_dev
# SOVIR_POSTGRES_DEV_PASSWORD=<local dev only>

# --- CI-only values used inside .github/workflows ---
# DATABASE_URL in CI is fixed to postgres://sovir_dev:ci_ephemeral_local_only@localhost:5432/sovir_dev
# SOVIR_ENV=test in CI enables the dev-session endpoint for the smoke job.

# --- Remote providers (all NOT IMPLEMENTED; set via secret manager when approved) ---
# META_MODEL_API_KEY=
# BASETEN_API_KEY=
# MODAL_TOKEN_ID= / MODAL_TOKEN_SECRET=
# FIREWORKS_API_KEY=
