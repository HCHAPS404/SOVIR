# SOVIR desktop observer — development config (Windows v0, ADR-0014).
# All values are optional; unset entries fall back to the defaults below.

# Loopback API base URL.
SOVIR_API_URL=http://127.0.0.1:8787

# Foreground-window metadata poll interval (ms).
SOVIR_OBSERVER_POLL_MS=2000

# Offline outbox: FIFO bound (oldest-drop beyond this) and optional
# durable encrypted store (sovir-edge-store SQLite). Unset = in-memory.
SOVIR_OBSERVER_QUEUE_MAX=64
# SOVIR_OBSERVER_STORE_PATH=C:\sovir\observer-outbox.db
# SOVIR_OBSERVER_STORE_KEY=change-me-in-dev-only

# Comma-separated process names never observed (e.g. your IDE).
# SOVIR_OBSERVER_EXCLUDE=code.exe,devenv.exe

# 1 disables the observer entirely (kill switch).
# SOVIR_OBSERVER_DISABLE=0

# ---------------------------------------------------------------------
# Pixel observation — OPT-IN, separate consent grant
# (win-observer-vision-grant). Emits IMAGE_REGION events carrying typed
# enums + frame sha256 only; pixels are consumed in-process and dropped.
# ---------------------------------------------------------------------

# 0 = ADR-0020 reversion kill-switch: wins over the opt-in below.
# SOVIR_EDGE_VISION=

# 1 enables the frame pipeline (default off).
# SOVIR_OBSERVER_VISION=1

# Frame source: wgc = real Windows.Graphics.Capture of the foreground
# window (requires `cargo build -p sovir-observer --features wgc`); the
# OS capture border stays visible. synthetic = procedural QR dev frame
# for end-to-end runs without a screen.
# SOVIR_OBSERVER_VISION_SOURCE=wgc

# Scan interval (ms, clamped 1000-60000).
# SOVIR_OBSERVER_VISION_MS=5000

# 1 runs on-device OCR (Windows.Media.Ocr) ONLY on frames already
# flagged by the structural/vision pass — never whole-screen (ADR-0019).
# SOVIR_OBSERVER_OCR=1
